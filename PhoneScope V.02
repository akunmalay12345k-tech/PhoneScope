<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PhoneScope — Info Ponselmu</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

  :root {
    --bg: #080c14;
    --surface: #0e1525;
    --card: #111827;
    --border: #1e2d45;
    --accent: #3b82f6;
    --accent2: #06b6d4;
    --green: #22c55e;
    --yellow: #f59e0b;
    --red: #ef4444;
    --purple: #a855f7;
    --text: #e2e8f0;
    --muted: #64748b;
    --dim: #334155;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Space Grotesk', sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* BG grid */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(59,130,246,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(59,130,246,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  .container {
    position: relative;
    z-index: 1;
    max-width: 700px;
    margin: 0 auto;
    padding: 24px 16px 60px;
  }

  /* Header */
  header {
    text-align: center;
    padding: 40px 0 32px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .logo-icon {
    width: 42px; height: 42px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
  }

  .logo-text {
    font-size: 26px;
    font-weight: 700;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.5px;
  }

  header p {
    color: var(--muted);
    font-size: 14px;
    font-weight: 400;
  }

  /* Scan button */
  .scan-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 32px;
  }

  #scanBtn {
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: #fff;
    border: none;
    border-radius: 14px;
    padding: 14px 36px;
    font-size: 15px;
    font-weight: 600;
    font-family: 'Space Grotesk', sans-serif;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: opacity 0.2s, transform 0.15s;
    box-shadow: 0 0 24px rgba(59,130,246,0.3);
  }

  #scanBtn:hover { opacity: 0.9; transform: translateY(-1px); }
  #scanBtn:active { transform: scale(0.97); }
  #scanBtn.scanning { opacity: 0.7; cursor: not-allowed; }

  .spinner {
    width: 16px; height: 16px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
    display: none;
  }

  .scanning .spinner { display: block; }
  .scanning .btn-icon { display: none; }

  @keyframes spin { to { transform: rotate(360deg); } }

  /* Grid sections */
  .grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .section-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
    padding-left: 4px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  /* Card */
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 20px;
    transition: border-color 0.2s;
  }

  .card:hover { border-color: var(--dim); }

  /* Info row */
  .info-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    gap: 12px;
  }

  .info-row:last-child { border-bottom: none; padding-bottom: 0; }
  .info-row:first-child { padding-top: 0; }

  .info-label {
    font-size: 13px;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
  }

  .info-label .ic {
    font-size: 15px;
    width: 20px;
    text-align: center;
  }

  .info-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--text);
    text-align: right;
    word-break: break-word;
  }

  .info-value.loading {
    color: var(--muted);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    animation: pulse 1.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }

  .badge {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
  }

  .badge-blue { background: rgba(59,130,246,0.15); color: var(--accent); }
  .badge-green { background: rgba(34,197,94,0.15); color: var(--green); }
  .badge-yellow { background: rgba(245,158,11,0.15); color: var(--yellow); }
  .badge-red { background: rgba(239,68,68,0.15); color: var(--red); }
  .badge-purple { background: rgba(168,85,247,0.15); color: var(--purple); }
  .badge-cyan { background: rgba(6,182,212,0.15); color: var(--accent2); }

  /* Battery bar */
  .battery-wrap {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .battery-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .battery-bar-outer {
    width: 100%;
    height: 8px;
    background: var(--border);
    border-radius: 4px;
    overflow: hidden;
  }

  .battery-bar-inner {
    height: 100%;
    border-radius: 4px;
    transition: width 1s ease, background 1s;
    width: 0%;
  }

  /* Screen size visual */
  .screen-vis {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .screen-mini {
    width: 28px; height: 48px;
    border: 2px solid var(--accent);
    border-radius: 5px;
    position: relative;
    flex-shrink: 0;
  }

  .screen-mini::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 50%; transform: translateX(-50%);
    width: 8px; height: 2px;
    background: var(--accent);
    border-radius: 1px;
  }

  /* Connection pills */
  .conn-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-end;
  }

  /* UA full */
  .ua-text {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    color: var(--muted);
    line-height: 1.6;
    word-break: break-all;
    background: var(--surface);
    border-radius: 8px;
    padding: 12px;
    margin-top: 8px;
    border: 1px solid var(--border);
  }

  /* Score card */
  .score-card {
    background: linear-gradient(135deg, rgba(59,130,246,0.08), rgba(6,182,212,0.08));
    border: 1px solid rgba(59,130,246,0.25);
    border-radius: 16px;
    padding: 20px;
    text-align: center;
  }

  .score-title {
    font-size: 12px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 6px;
  }

  .score-value {
    font-size: 48px;
    font-weight: 700;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    margin-bottom: 4px;
  }

  .score-sub {
    font-size: 12px;
    color: var(--muted);
  }

  /* hidden */
  .hidden { display: none; }

  /* Tip */
  .tip {
    text-align: center;
    font-size: 12px;
    color: var(--muted);
    margin-top: 8px;
  }

  /* footer */
  footer {
    text-align: center;
    padding-top: 40px;
    font-size: 12px;
    color: var(--dim);
  }

  /* Highlight OS row */
  .os-highlight .info-value {
    color: var(--accent2);
    font-weight: 600;
  }

  /* Big brand display */
  .brand-hero {
    text-align: center;
    padding: 16px 0 4px;
  }

  .brand-name {
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -1px;
    background: linear-gradient(135deg, var(--text), var(--muted));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .brand-model {
    font-size: 14px;
    color: var(--muted);
    margin-top: 2px;
  }
</style>
</head>
<body>
<div class="container">

  <header>
    <div class="logo">
      <div class="logo-icon">📱</div>
      <span class="logo-text">PhoneScope</span>
    </div>
    <p>Deteksi lengkap info ponsel kamu secara real-time</p>
  </header>

  <div class="scan-wrap">
    <button id="scanBtn" onclick="startScan()">
      <span class="btn-icon">🔍</span>
      <div class="spinner"></div>
      Scan Ponselku
    </button>
  </div>

  <div id="results" class="grid hidden">

    <!-- Brand / Model -->
    <div class="section-label">📱 Identitas Perangkat</div>
    <div class="card">
      <div class="brand-hero">
        <div class="brand-name" id="brandName">—</div>
        <div class="brand-model" id="modelName">Mendeteksi...</div>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🏷️</span> Brand</span>
        <span class="info-value" id="inBrand">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">📌</span> Model / Tipe</span>
        <span class="info-value" id="inModel">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">💻</span> Platform</span>
        <span class="info-value" id="inPlatform">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🖥️</span> Sistem Operasi</span>
        <span class="info-value" id="inOS">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">⚙️</span> Arsitektur</span>
        <span class="info-value" id="inArch">—</span>
      </div>
    </div>

    <!-- Chipset / CPU -->
    <div class="section-label">🧠 Chipset & Prosesor</div>
    <div class="card">
      <div class="info-row">
        <span class="info-label"><span class="ic">🧩</span> Chipset (Estimasi)</span>
        <span class="info-value" id="inChipset">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">⚡</span> CPU Cores</span>
        <span class="info-value" id="inCores">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🚀</span> GPU Renderer</span>
        <span class="info-value" id="inGPU">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🎮</span> GPU Vendor</span>
        <span class="info-value" id="inGPUVendor">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">📦</span> RAM (Estimasi)</span>
        <span class="info-value" id="inRAM">—</span>
      </div>
    </div>

    <!-- Layar -->
    <div class="section-label">🖥️ Layar & Display</div>
    <div class="card">
      <div class="info-row">
        <span class="info-label"><span class="ic">📐</span> Resolusi Layar</span>
        <span class="info-value" id="inResolution">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🔍</span> Device Pixel Ratio</span>
        <span class="info-value" id="inDPR">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">📏</span> Viewport (Browser)</span>
        <span class="info-value" id="inViewport">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🎨</span> Color Depth</span>
        <span class="info-value" id="inColorDepth">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">💡</span> HDR Support</span>
        <span class="info-value" id="inHDR">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🌈</span> Tipe Panel (Estimasi)</span>
        <span class="info-value" id="inPanel">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🔄</span> Refresh Rate (Estimasi)</span>
        <span class="info-value" id="inRefresh">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🌙</span> Dark Mode</span>
        <span class="info-value" id="inDarkMode">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">↔️</span> Orientasi Layar</span>
        <span class="info-value" id="inOrientation">—</span>
      </div>
    </div>

    <!-- Baterai -->
    <div class="section-label">🔋 Baterai</div>
    <div class="card">
      <div class="info-row">
        <span class="info-label"><span class="ic">🔋</span> Level Baterai</span>
        <div class="battery-wrap">
          <div class="battery-top">
            <span></span>
            <span class="info-value" id="inBatLevel">—</span>
          </div>
          <div class="battery-bar-outer">
            <div class="battery-bar-inner" id="batBar"></div>
          </div>
        </div>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🔌</span> Status Charging</span>
        <span class="info-value" id="inBatCharging">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">⏱️</span> Waktu Penuh</span>
        <span class="info-value" id="inBatTime">—</span>
      </div>
    </div>

    <!-- Koneksi -->
    <div class="section-label">📡 Jaringan & Koneksi</div>
    <div class="card">
      <div class="info-row">
        <span class="info-label"><span class="ic">📶</span> Tipe Koneksi</span>
        <span class="info-value" id="inConnType">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">⚡</span> Kecepatan Efektif</span>
        <span class="info-value" id="inConnSpeed">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">📊</span> Downlink (est.)</span>
        <span class="info-value" id="inDownlink">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🌐</span> Online Status</span>
        <span class="info-value" id="inOnline">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">💾</span> Data Saver</span>
        <span class="info-value" id="inDataSaver">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🛰️</span> Fitur Koneksi</span>
        <div class="conn-pills" id="inConnFeatures"></div>
      </div>
    </div>

    <!-- Sensor & Kapabilitas -->
    <div class="section-label">🎯 Sensor & Kapabilitas</div>
    <div class="card">
      <div class="info-row">
        <span class="info-label"><span class="ic">📳</span> Gyroscope</span>
        <span class="info-value" id="inGyro">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🧭</span> Akselerometer</span>
        <span class="info-value" id="inAccel">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">📍</span> GPS / Lokasi</span>
        <span class="info-value" id="inGPS">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">👆</span> Layar Sentuh</span>
        <span class="info-value" id="inTouch">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🔆</span> Max Touch Points</span>
        <span class="info-value" id="inTouchPoints">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🎤</span> Mikrofon</span>
        <span class="info-value" id="inMic">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">📷</span> Kamera</span>
        <span class="info-value" id="inCam">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🔊</span> Speaker</span>
        <span class="info-value" id="inSpeaker">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">📳</span> Vibration API</span>
        <span class="info-value" id="inVibration">—</span>
      </div>
    </div>

    <!-- Browser & Penyimpanan -->
    <div class="section-label">🌐 Browser & Penyimpanan</div>
    <div class="card">
      <div class="info-row">
        <span class="info-label"><span class="ic">🌐</span> Browser</span>
        <span class="info-value" id="inBrowser">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🔢</span> Versi Browser</span>
        <span class="info-value" id="inBrowserVer">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🌍</span> Bahasa</span>
        <span class="info-value" id="inLang">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">💽</span> Storage Tersedia</span>
        <span class="info-value" id="inStorage">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">📦</span> IndexedDB</span>
        <span class="info-value" id="inIDB">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🍪</span> Cookie Enabled</span>
        <span class="info-value" id="inCookie">—</span>
      </div>
      <div class="info-row">
        <span class="info-label"><span class="ic">🕒</span> Timezone</span>
        <span class="info-value" id="inTimezone">—</span>
      </div>
    </div>

    <!-- User Agent -->
    <div class="section-label">🔎 User Agent Lengkap</div>
    <div class="card">
      <div id="uaFull" class="ua-text">Mendeteksi...</div>
    </div>

    <!-- Footer note -->
    <div class="tip">
      ⚠️ Chipset & tipe panel adalah <b>estimasi</b> berbasis data yang tersedia dari browser.<br>
      Browser tidak memberi akses langsung ke hardware info secara lengkap.
    </div>

  </div><!-- end results -->

</div>

<footer>
  <p>PhoneScope · Semua deteksi berjalan lokal di perangkatmu · Tidak ada data yang dikirim</p>
</footer>

<script>
// ─────────────────────────────────────────
// Helper
// ─────────────────────────────────────────
function set(id, val) {
  const el = document.getElementById(id);
  if (el) el.textContent = val;
}

function setBadge(id, text, color) {
  const el = document.getElementById(id);
  if (!el) return;
  el.innerHTML = `<span class="badge badge-${color}">${text}</span>`;
}

function pill(text, color) {
  return `<span class="badge badge-${color}">${text}</span>`;
}

// ─────────────────────────────────────────
// Parse User Agent
// ─────────────────────────────────────────
function parseUA(ua) {
  const result = { brand: '?', model: '?', os: '?', osVersion: '', browser: '?', browserVersion: '', arch: '?' };

  // OS detection
  if (/android/i.test(ua)) {
    result.os = 'Android';
    const v = ua.match(/android\s([\d.]+)/i);
    if (v) result.osVersion = v[1];
  } else if (/iphone|ipad|ipod/i.test(ua)) {
    result.os = 'iOS';
    const v = ua.match(/os\s([\d_]+)/i);
    if (v) result.osVersion = v[1].replace(/_/g, '.');
  } else if (/windows phone/i.test(ua)) {
    result.os = 'Windows Phone';
  } else if (/windows/i.test(ua)) {
    result.os = 'Windows';
  } else if (/macintosh/i.test(ua)) {
    result.os = 'macOS';
  } else if (/linux/i.test(ua)) {
    result.os = 'Linux';
  }

  // Architecture
  if (/arm64|aarch64/i.test(ua)) result.arch = 'ARM64 (64-bit)';
  else if (/armv7|arm/i.test(ua)) result.arch = 'ARM (32-bit)';
  else if (/x86_64|x64|wow64/i.test(ua)) result.arch = 'x86_64 (64-bit)';
  else if (/x86/i.test(ua)) result.arch = 'x86 (32-bit)';
  else result.arch = 'Tidak diketahui';

  // Brand / Model dari UA Android
  if (result.os === 'Android') {
    const brands = [
      { re: /samsung\s?(sm-[a-z0-9]+|galaxy\s?[a-z0-9\s]+)/i, brand: 'Samsung' },
      { re: /xiaomi|redmi|poco/i, brand: 'Xiaomi' },
      { re: /oppo/i, brand: 'OPPO' },
      { re: /vivo/i, brand: 'vivo' },
      { re: /realme/i, brand: 'realme' },
      { re: /oneplus/i, brand: 'OnePlus' },
      { re: /huawei/i, brand: 'Huawei' },
      { re: /honor/i, brand: 'Honor' },
      { re: /infinix/i, brand: 'Infinix' },
      { re: /tecno/i, brand: 'Tecno' },
      { re: /motorola|moto\s[a-z]/i, brand: 'Motorola' },
      { re: /nokia/i, brand: 'Nokia' },
      { re: /asus/i, brand: 'ASUS' },
      { re: /lenovo/i, brand: 'Lenovo' },
      { re: /sony\s?(xperia)?/i, brand: 'Sony' },
      { re: /lg[\s\-]/i, brand: 'LG' },
      { re: /pixel\s?\d/i, brand: 'Google' },
    ];
    for (const b of brands) {
      if (b.re.test(ua)) { result.brand = b.brand; break; }
    }

    // Extract model from "Build/" section
    const mModel = ua.match(/\(.*?;\s*([^;)]+?)\s*(?:Build|MIUI|EMUI|\))/i);
    if (mModel) result.model = mModel[1].trim();
  } else if (result.os === 'iOS') {
    result.brand = 'Apple';
    if (/ipad/i.test(ua)) result.model = 'iPad';
    else if (/iphone/i.test(ua)) result.model = 'iPhone';
    else result.model = 'iPod Touch';
  }

  // Browser detection
  const browsers = [
    { re: /edg\/([\d.]+)/i, name: 'Microsoft Edge' },
    { re: /opr\/([\d.]+)/i, name: 'Opera' },
    { re: /samsung.*?([\d.]+)\s*(?:mobile)?safari/i, name: 'Samsung Internet' },
    { re: /miui.*browser\/([\d.]+)/i, name: 'MIUI Browser' },
    { re: /crios\/([\d.]+)/i, name: 'Chrome (iOS)' },
    { re: /chrome\/([\d.]+)/i, name: 'Chrome' },
    { re: /firefox\/([\d.]+)/i, name: 'Firefox' },
    { re: /safari\/([\d.]+)/i, name: 'Safari' },
  ];
  for (const b of browsers) {
    const m = ua.match(b.re);
    if (m) { result.browser = b.name; result.browserVersion = m[1]; break; }
  }

  return result;
}

// ─────────────────────────────────────────
// Chipset estimation from brand + model + UA
// ─────────────────────────────────────────
function estimateChipset(brand, model, ua, cores) {
  const m = model.toUpperCase();
  const u = ua;

  // Samsung
  if (brand === 'Samsung') {
    if (/SM-S9[0-9][0-9]|SM-S8[0-9][0-9]/i.test(m)) return 'Snapdragon 8 Gen / Exynos 2xxx';
    if (/SM-A5[0-9]/i.test(m)) return 'Exynos / MediaTek (seri A)';
    if (/SM-A7[0-9]/i.test(m)) return 'Snapdragon / Exynos (seri A7x)';
    if (/SM-M[0-9]/i.test(m)) return 'MediaTek Helio / Dimensity (seri M)';
    return 'Exynos / Snapdragon (Samsung)';
  }
  // Xiaomi / Redmi / POCO
  if (brand === 'Xiaomi') {
    if (/poco\s?x[0-9]/i.test(u)) return 'Snapdragon (POCO X-series)';
    if (/poco\s?m[0-9]/i.test(u)) return 'MediaTek Helio G (POCO M)';
    if (/redmi\s?note\s?1[0-9]/i.test(u)) return 'MediaTek Dimensity / Snapdragon';
    if (/redmi\s?note\s?[0-9]/i.test(u)) return 'MediaTek Helio / Dimensity';
    if (/redmi\s?[0-9]/i.test(u)) return 'MediaTek Helio (Redmi)';
    if (/mi\s?1[0-9]/i.test(u)) return 'Snapdragon 8xx (Mi flagship)';
    return 'Snapdragon / MediaTek Dimensity';
  }
  // OPPO
  if (brand === 'OPPO') {
    if (/find\s?x/i.test(u)) return 'Snapdragon 8xx (flagship)';
    if (/reno\s?[0-9]/i.test(u)) return 'Snapdragon / MediaTek Dimensity';
    if (/a[0-9]/i.test(m)) return 'Snapdragon / MediaTek Helio (seri A)';
    return 'MediaTek / Snapdragon (OPPO)';
  }
  // realme
  if (brand === 'realme') {
    if (/gt\s?[0-9]/i.test(u) || /gt\s?master/i.test(u)) return 'Snapdragon 8xx / Dimensity';
    if (/narzo/i.test(u)) return 'MediaTek Helio G (Narzo)';
    return 'MediaTek Helio / Dimensity';
  }
  // vivo
  if (brand === 'vivo') {
    if (/x[0-9][0-9]/i.test(m)) return 'Snapdragon 8xx / Dimensity (X-series)';
    if (/y[0-9][0-9]/i.test(m)) return 'MediaTek Helio / Snapdragon (Y-series)';
    return 'MediaTek / Snapdragon (vivo)';
  }
  // Google Pixel
  if (brand === 'Google') return 'Google Tensor (Pixel)';
  // Apple
  if (brand === 'Apple') return 'Apple Silicon (A-series)';
  // Fallback by cores
  if (cores >= 8) return `Octa-core (~${cores} core)`;
  if (cores >= 6) return `Hexa-core (${cores} core)`;
  if (cores >= 4) return `Quad-core (${cores} core)`;
  return 'Tidak terdeteksi';
}

// ─────────────────────────────────────────
// Estimate panel type
// ─────────────────────────────────────────
function estimatePanel(brand, dpr, depth, hdr) {
  // Apple uses OLED on newer iPhones
  if (brand === 'Apple') return hdr ? 'Super Retina XDR (OLED)' : 'Retina IPS LCD';
  // Samsung flagships often AMOLED
  if (brand === 'Samsung') {
    if (dpr >= 3) return 'Dynamic AMOLED 2x (estimasi)';
    if (dpr >= 2.5) return 'Super AMOLED (estimasi)';
    return 'IPS LCD / PLS TFT (estimasi)';
  }
  if (brand === 'Google') return 'OLED (Pixel)';
  if (hdr && dpr >= 3) return 'AMOLED / OLED (estimasi, HDR tinggi)';
  if (dpr >= 3) return 'AMOLED / OLED (estimasi)';
  if (dpr >= 2) return 'IPS LCD / AMOLED (estimasi)';
  return 'IPS LCD (estimasi)';
}

// ─────────────────────────────────────────
// Estimate refresh rate using rAF
// ─────────────────────────────────────────
function measureRefreshRate() {
  return new Promise(resolve => {
    let last = null;
    let deltas = [];
    let frames = 0;
    function frame(ts) {
      if (last !== null) deltas.push(ts - last);
      last = ts;
      frames++;
      if (frames < 20) requestAnimationFrame(frame);
      else {
        const avg = deltas.reduce((a, b) => a + b, 0) / deltas.length;
        const hz = Math.round(1000 / avg);
        if (hz > 100) resolve('120 Hz (High Refresh)');
        else if (hz > 75) resolve('90 Hz (High Refresh)');
        else resolve('60 Hz (Standar)');
      }
    }
    requestAnimationFrame(frame);
  });
}

// ─────────────────────────────────────────
// Battery
// ─────────────────────────────────────────
async function getBattery() {
  try {
    const bat = await navigator.getBattery();
    const pct = Math.round(bat.level * 100);
    set('inBatLevel', pct + '%');
    // bar
    const bar = document.getElementById('batBar');
    bar.style.width = pct + '%';
    bar.style.background = pct > 60 ? 'var(--green)' : pct > 20 ? 'var(--yellow)' : 'var(--red)';

    if (bat.charging) {
      document.getElementById('inBatCharging').innerHTML = pill('⚡ Sedang Charging', 'green');
    } else {
      document.getElementById('inBatCharging').innerHTML = pill('🔋 Tidak Charging', 'yellow');
    }
    if (bat.chargingTime === Infinity || bat.chargingTime === 0) {
      set('inBatTime', bat.charging ? 'Sudah penuh / tidak diketahui' : '—');
    } else {
      const mins = Math.round(bat.chargingTime / 60);
      set('inBatTime', `~${mins} menit lagi penuh`);
    }
  } catch {
    set('inBatLevel', 'API tidak didukung browser ini');
    set('inBatCharging', 'N/A');
    set('inBatTime', 'N/A');
  }
}

// ─────────────────────────────────────────
// GPU via WebGL
// ─────────────────────────────────────────
function getGPU() {
  try {
    const canvas = document.createElement('canvas');
    const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
    if (!gl) return { renderer: 'WebGL tidak tersedia', vendor: '—' };
    const ext = gl.getExtension('WEBGL_debug_renderer_info');
    if (ext) {
      return {
        renderer: gl.getParameter(ext.UNMASKED_RENDERER_WEBGL),
        vendor: gl.getParameter(ext.UNMASKED_VENDOR_WEBGL)
      };
    }
    return { renderer: gl.getParameter(gl.RENDERER), vendor: gl.getParameter(gl.VENDOR) };
  } catch {
    return { renderer: 'Tidak terdeteksi', vendor: '—' };
  }
}

// ─────────────────────────────────────────
// Storage estimate
// ─────────────────────────────────────────
async function getStorage() {
  try {
    if (navigator.storage && navigator.storage.estimate) {
      const est = await navigator.storage.estimate();
      const used = (est.usage / 1e6).toFixed(1);
      const quota = (est.quota / 1e6).toFixed(0);
      return `${used} MB terpakai / ~${quota} MB tersedia`;
    }
    return 'API tidak didukung';
  } catch {
    return 'Tidak dapat diakses';
  }
}

// ─────────────────────────────────────────
// Main scan
// ─────────────────────────────────────────
async function startScan() {
  const btn = document.getElementById('scanBtn');
  btn.classList.add('scanning');
  btn.textContent = '';
  btn.innerHTML = '<div class="spinner"></div> Menganalisis...';

  document.getElementById('results').classList.remove('hidden');

  const ua = navigator.userAgent;
  const info = parseUA(ua);
  const cores = navigator.hardwareConcurrency || 0;

  // Brand / Model
  document.getElementById('brandName').textContent = info.brand !== '?' ? info.brand : 'Unknown';
  document.getElementById('modelName').textContent = info.model !== '?' ? info.model + (info.os ? ` · ${info.os} ${info.osVersion}` : '') : 'Model tidak terdeteksi';
  set('inBrand', info.brand);
  set('inModel', info.model);
  set('inPlatform', /mobile/i.test(ua) ? 'Mobile' : /tablet/i.test(ua) ? 'Tablet' : 'Desktop / Lainnya');
  set('inOS', `${info.os} ${info.osVersion}`);
  set('inArch', info.arch);

  // GPU
  const gpu = getGPU();
  set('inGPU', gpu.renderer || '—');
  set('inGPUVendor', gpu.vendor || '—');

  // Chipset
  const chipset = estimateChipset(info.brand, info.model, ua, cores);
  set('inChipset', chipset);

  // Cores
  set('inCores', cores ? `${cores} core` : 'Tidak diketahui');

  // RAM via deviceMemory
  const ram = navigator.deviceMemory;
  set('inRAM', ram ? `≥${ram} GB (deviceMemory API)` : 'Tidak dapat dideteksi');

  // Screen
  const sw = screen.width, sh = screen.height;
  const dpr = window.devicePixelRatio || 1;
  const vw = window.innerWidth, vh = window.innerHeight;
  const cd = screen.colorDepth;
  const hdr = window.matchMedia('(dynamic-range: high)').matches;
  const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  const ori = screen.orientation ? screen.orientation.type : (sw > sh ? 'landscape' : 'portrait');

  set('inResolution', `${sw * dpr} × ${sh * dpr} px (fisik)`);
  set('inDPR', `${dpr}x`);
  set('inViewport', `${vw} × ${vh} px`);
  set('inColorDepth', `${cd}-bit`);
  document.getElementById('inHDR').innerHTML = hdr ? pill('✅ HDR Didukung', 'green') : pill('❌ Tidak ada HDR', 'red');
  document.getElementById('inDarkMode').innerHTML = dark ? pill('🌙 Dark Mode', 'purple') : pill('☀️ Light Mode', 'yellow');
  set('inOrientation', ori);

  // Panel
  const panel = estimatePanel(info.brand, dpr, cd, hdr);
  document.getElementById('inPanel').innerHTML = `<span class="badge badge-cyan">${panel}</span>`;

  // Refresh rate
  const refreshRate = await measureRefreshRate();
  set('inRefresh', refreshRate);

  // Battery
  await getBattery();

  // Network
  const conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
  if (conn) {
    set('inConnType', conn.type || '—');
    set('inConnSpeed', conn.effectiveType ? conn.effectiveType.toUpperCase() : '—');
    set('inDownlink', conn.downlink ? `~${conn.downlink} Mbps` : '—');
    document.getElementById('inDataSaver').innerHTML = conn.saveData ? pill('Aktif', 'yellow') : pill('Tidak aktif', 'green');
  } else {
    set('inConnType', 'API tidak tersedia');
    set('inConnSpeed', '—');
    set('inDownlink', '—');
    set('inDataSaver', '—');
  }
  document.getElementById('inOnline').innerHTML = navigator.onLine ? pill('🟢 Online', 'green') : pill('🔴 Offline', 'red');

  // Connection features
  const features = [];
  if ('bluetooth' in navigator) features.push(pill('Bluetooth', 'blue'));
  if ('usb' in navigator) features.push(pill('USB', 'cyan'));
  if ('serial' in navigator) features.push(pill('Serial', 'purple'));
  if (conn?.type === 'wifi') features.push(pill('WiFi', 'green'));
  if (conn?.type === 'cellular') features.push(pill('Seluler', 'yellow'));
  document.getElementById('inConnFeatures').innerHTML = features.length ? features.join('') : pill('Tidak terdeteksi', 'dim');

  // Sensors
  document.getElementById('inGyro').innerHTML = ('DeviceOrientationEvent' in window) ? pill('✅ Tersedia', 'green') : pill('❌ Tidak ada', 'red');
  document.getElementById('inAccel').innerHTML = ('DeviceMotionEvent' in window) ? pill('✅ Tersedia', 'green') : pill('❌ Tidak ada', 'red');
  document.getElementById('inGPS').innerHTML = ('geolocation' in navigator) ? pill('✅ Tersedia', 'green') : pill('❌ Tidak ada', 'red');

  const touch = navigator.maxTouchPoints > 0;
  document.getElementById('inTouch').innerHTML = touch ? pill('✅ Layar Sentuh', 'green') : pill('❌ Bukan touchscreen', 'red');
  set('inTouchPoints', `${navigator.maxTouchPoints} titik sentuh`);

  // Media devices
  try {
    const devs = await navigator.mediaDevices.enumerateDevices();
    const mic = devs.some(d => d.kind === 'audioinput');
    const cam = devs.some(d => d.kind === 'videoinput');
    const spk = devs.some(d => d.kind === 'audiooutput');
    document.getElementById('inMic').innerHTML = mic ? pill('✅ Terdeteksi', 'green') : pill('❌ Tidak terdeteksi', 'red');
    document.getElementById('inCam').innerHTML = cam ? pill('✅ Terdeteksi', 'green') : pill('❌ Tidak terdeteksi', 'red');
    document.getElementById('inSpeaker').innerHTML = spk ? pill('✅ Terdeteksi', 'green') : pill('❌ Tidak terdeteksi', 'red');
  } catch {
    document.getElementById('inMic').innerHTML = pill('Akses ditolak', 'yellow');
    document.getElementById('inCam').innerHTML = pill('Akses ditolak', 'yellow');
    document.getElementById('inSpeaker').innerHTML = pill('Akses ditolak', 'yellow');
  }

  document.getElementById('inVibration').innerHTML = ('vibrate' in navigator) ? pill('✅ Tersedia', 'green') : pill('❌ Tidak ada', 'red');

  // Browser
  set('inBrowser', info.browser);
  set('inBrowserVer', info.browserVersion || '—');
  set('inLang', navigator.language || '—');

  // Storage
  set('inStorage', await getStorage());
  document.getElementById('inIDB').innerHTML = ('indexedDB' in window) ? pill('✅ Tersedia', 'green') : pill('❌ Tidak ada', 'red');
  document.getElementById('inCookie').innerHTML = navigator.cookieEnabled ? pill('✅ Aktif', 'green') : pill('❌ Nonaktif', 'red');
  set('inTimezone', Intl.DateTimeFormat().resolvedOptions().timeZone || '—');

  // UA full
  document.getElementById('uaFull').textContent = ua;

  // Done
  btn.classList.remove('scanning');
  btn.innerHTML = '<span class="btn-icon">✅</span> Selesai — Scan Ulang';
}
</script>
</body>
</html>
